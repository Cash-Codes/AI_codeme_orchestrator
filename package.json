{
  "name": "codemeai-orchestrator",
  "version": "0.1.0",
  "description": "AI ticket orchestrator — responds to @codemeai tags, makes scoped code changes, posts clear comments",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:all": "concurrently -n backend,frontend -c cyan,magenta \"npm run dev\" \"npm run dev:frontend\"",
    "build": "npm run build:frontend && tsc",
    "build:frontend": "cd frontend && npm run build",
    "dev:frontend": "cd frontend && npm run dev",
    "start": "node dist/server.js",
    "seed": "tsx scripts/seed.ts",
    "lint": "biome check src frontend/src",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.97",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.30.8",
    "express": "^4.22.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.7.3",
    "@types/better-sqlite3": "^7.6.10",
    "@types/express": "^4.17.25",
    "@types/node": "^22.19.17",
    "@types/supertest": "^7.2.0",
    "@vitest/coverage-v8": "^4.1.4",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.21.2",
    "esbuild": "^0.28.0",
    "husky": "^9.1.7",
    "supertest": "^7.2.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.4"
  }
}
